body {
    background: #f4f7fb;
    color: #24334b;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.65;
}

a { color: #2459ad; }
a:hover, a:focus { color: #173e7c; }
h1, h2, h3 { color: #172a46; line-height: 1.25; font-weight: 600; }
h1 { font-size: 32px; margin-bottom: 24px; }
h2 { font-size: 24px; }
h3 { font-size: 19px; }

.navbar {
    background: #172a46;
    border: 0;
    margin-bottom: 28px;
}
.navbar-header { float: none; }
.navbar-default .navbar-brand, .navbar-default .navbar-brand:hover,
.navbar-default .navbar-brand:focus { color: white; font-weight: 700; }
.navbar-default .navbar-nav > li > a { color: #e4ecf8; }
.navbar-default .navbar-nav > li > a:hover,
.navbar-default .navbar-nav > li > a:focus,
.navbar-default .navbar-nav > .active > a,
.navbar-default .navbar-nav > .active > a:hover,
.navbar-default .navbar-nav > .active > a:focus {
    color: white;
    background: #294263;
}
.navbar-default .navbar-toggle { border-color: #7b91ad; }
.navbar-default .navbar-toggle:hover, .navbar-default .navbar-toggle:focus { background: #294263; }
.navbar-default .navbar-toggle .icon-bar { background: white; }
.navbar-default .navbar-collapse { border-color: #294263; }
.navbar-nav > li > a { font-size: 13px; padding-left: 10px; padding-right: 10px; }

.page-content { min-height: 65vh; padding-bottom: 36px; }
.container, .panel-body, .home-card { overflow-wrap: break-word; }
.breadcrumb { background: transparent; padding: 0; margin-bottom: 24px; }
.panel, .well {
    background: white;
    border: 1px solid #dce4ef;
    border-radius: 12px;
    box-shadow: none;
}
.panel-body { padding: 24px; }
.panel-body h2 { margin-top: 0; }

form { margin-bottom: 20px; }
input, select, textarea { max-width: 100%; }
.form-control, input:not([type=hidden]):not([type=checkbox]):not([type=radio]):not([type=submit]), select, textarea {
    border: 1px solid #b6c5d9;
    border-radius: 6px;
    padding: 8px 12px;
    background: white;
    color: #24334b;
}
.form-control { height: auto; min-height: 40px; }
textarea.form-control { min-height: 100px; }
label { color: #334964; }
.btn, button[type=submit] { border-radius: 6px; font-weight: 600; }
button[type=submit] { padding: 8px 16px; }
.btn-primary { background: #2459ad; border-color: #2459ad; }
.btn-primary:hover, .btn-primary:focus { background: #173e7c; border-color: #173e7c; }
.btn-default { background: white; color: #24334b; border-color: #b6c5d9; }
.btn + .btn { margin-left: 4px; }
a:focus, button:focus, input:focus, select:focus, textarea:focus {
    outline: 3px solid #6d9ee2;
    outline-offset: 3px;
}
#message { margin-bottom: 24px; }
.alert { border-radius: 8px; }
.footer { border-top: 1px solid #dce4ef; padding: 24px 0; background: white; }
.footer p { margin: 0; }

.home-hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    padding: 44px;
    background: #e7eef9;
    border-radius: 18px;
}
.eyebrow { color: #2459ad; text-transform: uppercase; letter-spacing: 1.5px; font-size: 12px; font-weight: 700; }
.hero-copy h1 { font-size: 42px; margin-top: 12px; }
.hero-description { font-size: 18px; margin-bottom: 28px; }
.home-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.home-actions .btn + .btn { margin-left: 0; }
.welcome-note { flex-basis: 100%; margin: 8px 0 0; }
.hero-summary { background: white; border-radius: 12px; padding: 28px; }
.hero-summary h2 { margin-top: 10px; }
.hero-summary ol { padding-left: 22px; }
.hero-summary li { margin-top: 16px; }
.home-section { margin-top: 48px; }
.home-section > h2 { margin-bottom: 24px; }
.home-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.home-card { padding: 28px; background: white; border: 1px solid #dce4ef; border-radius: 12px; }
.step-number { color: #2459ad; font-weight: 700; font-size: 22px; }
.home-card h3 { margin-top: 18px; }
.home-card p { margin-bottom: 0; }
.home-help { padding: 28px; border-top: 1px solid #dce4ef; }
.home-help h2 { margin-top: 0; }

@media (max-width: 767px) {
    h1 { font-size: 28px; }
    .home-hero { grid-template-columns: 1fr; padding: 24px; gap: 24px; }
    .hero-copy h1 { font-size: 32px; }
    .home-grid { grid-template-columns: 1fr; }
    .home-section { margin-top: 32px; }
    .home-help { padding: 20px 0; }
    .home-actions .btn { white-space: normal; }
    .navbar-nav > li > a { padding: 12px 16px; }
}
